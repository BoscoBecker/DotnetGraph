<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DotnetGraph.Extension</RootNamespace>
    <AssemblyName>DotnetGraph.Extension</AssemblyName>
    <UseWPF>true</UseWPF>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <UseCodebase>true</UseCodebase>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeCopyLocalReferencesInVSIXContainer>true</IncludeCopyLocalReferencesInVSIXContainer>
  </PropertyGroup>

  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.11.40262" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetGraph.Core\DotnetGraph.Core.csproj">
      <IncludeInVSIX>true</IncludeInVSIX>
    </ProjectReference>
  </ItemGroup>

  <Target Name="EnsureGraphIcons" BeforeTargets="VSCTCompile;PrepareForBuild">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)..\..\scripts\ensure-icons.cmd&quot;" IgnoreExitCode="false" />
  </Target>

  <!--
    IncludeCopyLocalReferencesInVSIXContainer often skips transitive deps of ProjectReferences
    (System.Text.Json, Roslyn, etc.). F5 works via the output folder; a standalone VSIX did not.
    Only force-add the assemblies that were historically missing from the VSIX.
  -->
  <Target Name="IncludeRuntimeDependenciesInVSIX" AfterTargets="ResolveAssemblyReferences;CopyFilesToOutputDirectory" BeforeTargets="GetVsixSourceItems;CreateVsixContainer">
    <ItemGroup>
      <_VsixRuntimeDll Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)Microsoft.CodeAnalysis.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)Microsoft.CodeAnalysis.CSharp.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)Microsoft.CodeAnalysis.VisualBasic.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Buffers.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Collections.Immutable.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Memory.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Numerics.Vectors.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Reflection.Metadata.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Text.Json.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.Threading.Tasks.Extensions.dll" />
      <_VsixRuntimeDll Include="$(TargetDir)System.ValueTuple.dll" />
      <VSIXSourceItem Include="@(_VsixRuntimeDll)" Condition="Exists('%(Identity)')">
        <VSIXSubPath>.</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Embedded for WPF pack:// header; also shipped as Content for VSIX Icon + Image Service. -->
    <Resource Include="Resources\Icons\PackageIcon.png" />
    <Content Include="Resources\Icons\*.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="DotnetGraph.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Graph\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

</Project>
